# Application
APP_NAME=Autonomous Exam Proctoring & Grading Agent
APP_VERSION=1.0.0

# Database
DATABASE_PATH=data/exam_agent.db

# Model paths
RISK_MODEL_PATH=models/risk_model.pkl
PERFORMANCE_MODEL_PATH=models/performance_model.pkl

# Proctoring
FACE_CONFIDENCE_THRESHOLD=0.7
MAX_FACE_ABSENCE_SECONDS=10
HEAD_TURN_THRESHOLD_DEGREES=45

# Risk scoring
ALPHA_DECAY=0.8
ESCALATION_THRESHOLD=0.7
REVIEW_THRESHOLD=0.5

# Grading
TFIDF_MIN_SIMILARITY=0.4
KEYWORD_COVERAGE_THRESHOLD=0.6
NUMERICAL_TOLERANCE=0.02

# Logging
LOG_LEVEL=INFO
LOG_FILE=data/agent.log
